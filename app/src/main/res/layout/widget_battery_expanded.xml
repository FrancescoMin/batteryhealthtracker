<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_notification"
            android:tint="#00E5FF" />

        <TextView
            android:id="@+id/widget_expanded_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="#F8FAFC"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_expanded_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:textColor="#64748B"
            android:textSize="10sp"
            android:singleLine="true" />

        <ImageView
            android:id="@+id/widget_expanded_btn_refresh"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_widget_refresh"
            android:tint="#94A3B8"
            android:background="@drawable/widget_refresh_button"
            android:padding="4dp"
            android:contentDescription="@string/action_refresh" />
    </LinearLayout>

    <!-- 2x2 Grid of Cards -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Row 1: SOH and Cycles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <!-- Card SOH -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_metric_tile"
                android:padding="10dp"
                android:layout_marginEnd="3dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_heart_battery"
                        android:tint="#00E5FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_health_title"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_expanded_soh_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textColor="#00E5FF"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_expanded_soh_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_health_sub_bms"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Card Cycles -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_metric_tile"
                android:padding="10dp"
                android:layout_marginStart="3dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_cycles"
                        android:tint="#E2E8F0" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_cycles_title"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_expanded_cycles_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textColor="#F8FAFC"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_expanded_cycles_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/card_cycles_sub"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Live Wattage and Temperature -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- Card Wattage -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_metric_tile"
                android:padding="10dp"
                android:layout_marginEnd="3dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/widget_expanded_watt_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_bolt"
                        android:tint="#00E676" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_wattage_label"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_expanded_watt_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0 W"
                    android:textColor="#00E676"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_expanded_watt_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_charging"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Card Temperature -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:background="@drawable/widget_metric_tile"
                android:padding="10dp"
                android:layout_marginStart="3dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/widget_expanded_temp_icon"
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginEnd="5dp"
                        android:src="@drawable/ic_widget_temp"
                        android:tint="#38BDF8" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/widget_temp_label"
                        android:textColor="#94A3B8"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:singleLine="true" />
                </LinearLayout>

                <TextView
                    android:id="@+id/widget_expanded_temp_val"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C"
                    android:textColor="#38BDF8"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:singleLine="true" />

                <TextView
                    android:id="@+id/widget_expanded_temp_sub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Normale"
                    android:textColor="#64748B"
                    android:textSize="10sp"
                    android:layout_marginTop="2dp"
                    android:singleLine="true" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
